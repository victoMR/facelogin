FACELOGIN_MASTER_KEY=
FACELOGIN_SESSION_SECRET=
FACELOGIN_PORT=8787
FACELOGIN_LSH_SEED=facelogin-lsh-v1
# HMAC de las cubetas LSH. Independiente de FACELOGIN_SESSION_SECRET.
# Se genera solo en el primer arranque. Rotarla obliga a reconstruir el índice.
FACELOGIN_LSH_HMAC_KEY=
# Opcional. Si se define, /api/enroll exige "Authorization: Bearer <token>".
# Si se deja vacío, el enrolamiento queda ABIERTO (modo demo) y el backend lo avisa al arrancar.
FACELOGIN_ENROLL_TOKEN=
# Obligatorio para DELETE /api/identities y el panel /admin.
# Si falta al arrancar, se genera solo y se escribe en .env.
# No lo pongas en el frontend.
FACELOGIN_ADMIN_TOKEN=

# ---------------------------------------------------------------- OIDC (IdP)
# Emisor anunciado en /.well-known/openid-configuration. Debe ser el origen
# público exacto del backend; en producción, https.
FACELOGIN_ISSUER=http://localhost:8787
# Origen de la interfaz a la que /authorize manda al usuario para el flujo facial.
FACELOGIN_APP_ORIGIN=http://localhost:5173

# Clave privada RS256 del IdP: DER PKCS#8 en base64, una sola línea. Se genera
# sola en el primer arranque. Para ROTAR: pon la nueva delante y deja la vieja
# detrás separada por coma; el JWKS publica las dos y se firma con la primera.
#   FACELOGIN_OIDC_PRIVATE_KEY=<nueva>,<anterior>
FACELOGIN_OIDC_PRIVATE_KEY=

# Sal del HMAC que deriva el `sub` pairwise. Se genera sola en el primer
# arranque. ROTARLA CAMBIA EL sub DE TODOS LOS USUARIOS EN TODOS LOS CLIENTES:
# es una migración, no una operación de mantenimiento.
FACELOGIN_OIDC_PAIRWISE_SALT=

# Solo si de verdad hay un proxy de confianza delante (nginx, ALB...). Sin
# proxy, activarlo permite saltarse el rate limit por IP con un X-Forwarded-For
# inventado. Valor: número de saltos de confianza (normalmente 1).
FACELOGIN_TRUST_PROXY=

# Registro de clientes. Opcional si usas el panel /admin para crear apps.
# JSON en línea:
#   FACELOGIN_OIDC_CLIENTS=[{"client_id":"demo","name":"Demo","redirect_uris":["https://demo.example/callback"],"client_secret":"..."}]
FACELOGIN_OIDC_CLIENTS=
# ...o un archivo (ver backend/config/clients.example.json):
FACELOGIN_OIDC_CLIENTS_FILE=
# Los clientes creados desde /admin viven en backend/data/oidc-clients.json
# (no hace falta tocar el env para cada app nueva).
